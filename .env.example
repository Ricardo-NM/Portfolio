# GitHub personal access token used to load the contribution calendar.
GITHUB_TOKEN=replace_with_github_token

# Resend API key used by the contact form email endpoint.
RESEND_API_KEY=replace_with_resend_api_key

# Email address where contact form messages should arrive.
CONTACT_TO_EMAIL=your_inbox@example.com

# Verified sender address configured in Resend.
# Use onboarding@resend.dev only for Resend test mode, or replace it with your verified domain sender.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
