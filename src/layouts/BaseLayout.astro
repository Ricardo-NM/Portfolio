---
import { ClientRouter } from "astro:transitions";
import PreferenceControls from "../components/PreferenceControls";
import "../styles/global.css";

type Props = {
  description: string;
  title?: string;
};

const { description, title = "Ricardo NM | Portafolio" } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        const getPreferences = () => {
          const storedTheme = localStorage.getItem("rn-theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

          return {
            locale: localStorage.getItem("rn-locale") || "es",
            theme: storedTheme || (prefersDark ? "dark" : "light"),
          };
        };
        const applyPreferences = (root) => {
          const { locale, theme } = getPreferences();

          root.dataset.theme = theme;
          root.lang = locale;
        };

        applyPreferences(document.documentElement);

        document.addEventListener("astro:before-swap", (event) => {
          delete event.newDocument.documentElement.dataset.localeTransition;
          delete event.newDocument.documentElement.dataset.suppressEntryAnimations;
          applyPreferences(event.newDocument.documentElement);
        });

        document.addEventListener("astro:after-swap", () => {
          delete document.documentElement.dataset.localeTransition;
          delete document.documentElement.dataset.suppressEntryAnimations;
          applyPreferences(document.documentElement);
        });
      })();
    </script>
  </head>
  <body>
    <slot />
    <PreferenceControls
      mode="chrome"
      client:only="react"
      transition:persist="site-chrome"
    />
  </body>
</html>
